# ─────────────────────────────────────────────────────────────
# 공개 값 (브라우저 번들에 포함됨. 비밀은 절대 여기 두지 않는다)
# ─────────────────────────────────────────────────────────────

# Supabase 프로젝트 URL. /rest/v1/ 는 붙이지 않는다.
# 예: https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Dashboard → Project Settings → API Keys 의 publishable 키(sb_publishable_...)
# 또는 legacy anon JWT(eyJ...). secret / service_role 키는 넣지 않는다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true면 실 DB를 무시하고 mock을 쓴다. 테스트와 e2e만 true.
# 자기 Supabase에 붙일 때는 false.
NEXT_PUBLIC_ENABLE_MSW=false

# ─────────────────────────────────────────────────────────────
# 서버 전용 (Route Handler에서만 사용, NEXT_PUBLIC_ 접두사 없음)
# ─────────────────────────────────────────────────────────────

# Nominatim 이용 정책상 User-Agent 명시가 필수다 (app/api/geocode).
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=travel-planner-dev/0.1 (contact@example.com)

# 네이버 클라우드 플랫폼 Dynamic Map Client ID.
# 없으면 플래너는 OSM 임시 지도를 쓴다. 로컬에서 쓰려면 .env.local에 넣고
# NCP 콘솔에서 http://localhost:3000 을 허용한 뒤 `pnpm dev`를 재시작한다.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# Directions 5(자동차 경로)는 Client Secret이 필요하다. Dynamic Map Client ID만으로는 안 된다.
NAVER_MAP_CLIENT_SECRET=

# 환율(app/api/currency)은 Frankfurter를 쓴다 — 키가 필요 없다
# (docs/09 D11에서 실제 호출로 검증됨). 별도 환경변수 없음.

# RLS 우회 키. Phase 10 이후 실제로 필요해지면(예: 공유 링크 검증) 추가한다.
# 지금은 사용하는 코드가 없다.
# SUPABASE_SERVICE_ROLE_KEY=
